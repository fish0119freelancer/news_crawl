name: Test LINE Push

on:
  workflow_dispatch: # 手動觸發測試

jobs:
  test-line-push:
    runs-on: ubuntu-latest
    steps:
      - name: Set up jq
        run: sudo apt-get update && sudo apt-get install -y jq

      - name: Send LINE message
        run: |
          TODAY=$(date +"%Y%m%d")
          URL="https://example.com/news_summary_${TODAY}.pdf"
          TITLES="1. 測試新聞標題 A\n2. 測試新聞標題 B"
          MSG="嗨!大家! 這是今天 ${TODAY} 的每日生醫新聞報告 :\n${TITLES}\n${URL}"

          PAYLOAD=$(jq -n --arg to "${{ secrets.LINE_USER_ID }}" --arg msg "$MSG" \
            '{to:$to, messages:[{type:"text", text:$msg}]}')

          echo "📤 Sending LINE push notification..."
          curl -X POST https://api.line.me/v2/bot/message/push \
            -H "Authorization: Bearer ${{ secrets.LINE_TOKEN }}" \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD"
