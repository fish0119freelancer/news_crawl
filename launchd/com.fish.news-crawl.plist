<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.fish.news-crawl</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/fish/side-proj/news_crawl/run_daily.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/fish/side-proj/news_crawl</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>TZ</key>
		<string>Asia/Taipei</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/fish/Library/Logs/news_crawl/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/fish/Library/Logs/news_crawl/launchd.err.log</string>
</dict>
</plist>
